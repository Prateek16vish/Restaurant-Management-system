/* ============================================================
   MENU
============================================================ */

function saveMenu(){

    localStorage.setItem(
        "menuItems",
        JSON.stringify(menuItems)
    );

    updateMenuCount();
}


function renderMenu(){

    const container =
        document.getElementById("menuContainer");

    const search =
        document.getElementById("menuSearch")
        .value.toLowerCase();

    const category =
        document.getElementById("categoryFilter")
        .value;


    let filtered=menuItems.filter(item=>{

        const matchesSearch =
            item.name.toLowerCase()
            .includes(search);

        const matchesCategory =
            category==="All" ||
            item.category===category;

        return matchesSearch &&
               matchesCategory;

    });


    if(filtered.length===0){

        container.innerHTML=`

            <div class="panel"
                 style="grid-column:1/-1;text-align:center;padding:50px;">

                <h3>No menu items found</h3>

                <p style="color:#777;margin-top:8px;">
                    Add a new item or change your search.
                </p>

            </div>

        `;

        return;
    }


    container.innerHTML=filtered.map(item=>`

        <div class="menu-card">

            <div class="menu-image">
                ${item.emoji}
            </div>

            <div class="menu-body">

                <h3>
                    ${escapeHTML(item.name)}
                </h3>

                <div class="menu-description">
                    ${escapeHTML(item.description || "")}
                </div>

                <div class="price">
                    ₹${item.price}
                </div>

                <div class="menu-footer">

                    <div class="availability">

                        <span class="dot ${
                            item.available ? "" : "off"
                        }"></span>

                        ${
                            item.available
                            ? "Available"
                            : "Unavailable"
                        }

                    </div>

                    <div class="menu-actions">

                        <button class="edit-btn"
                                onclick="editMenu(${item.id})">
                            Edit
                        </button>

                        <button class="danger-btn"
                                onclick="deleteMenu(${item.id})">
                            Delete
                        </button>

                    </div>

                </div>

                <br>

                <button class="${
                    item.available
                    ? "secondary-btn"
                    : "primary-btn"
                }"
                style="width:100%"
                onclick="toggleAvailability(${item.id})">

                    ${
                        item.available
                        ? "Mark Unavailable"
                        : "Make Available"
                    }

                </button>

            </div>

        </div>

    `).join("");

}


function openAddMenuModal(){

    document.getElementById("menuForm")
        .reset();

    document.getElementById("foodAvailable")
        .checked=true;

    document.getElementById("editMenuId")
        .value="";

    document.getElementById("modalTitle")
        .innerText="Add Menu Item";

    document.getElementById("menuModal")
        .classList.remove("hidden");

}


function editMenu(id){

    const item =
        menuItems.find(x=>x.id===id);

    if(!item){
        return;
    }


    document.getElementById("editMenuId")
        .value=item.id;

    document.getElementById("foodName")
        .value=item.name;

    document.getElementById("foodDescription")
        .value=item.description;

    document.getElementById("foodPrice")
        .value=item.price;

    document.getElementById("foodCategory")
        .value=item.category;

    document.getElementById("foodEmoji")
        .value=item.emoji;

    document.getElementById("foodAvailable")
        .checked=item.available;


    document.getElementById("modalTitle")
        .innerText="Edit Menu Item";

    document.getElementById("menuModal")
        .classList.remove("hidden");

}


function closeMenuModal(){

    document.getElementById("menuModal")
        .classList.add("hidden");

}


document.getElementById("menuForm")
.addEventListener("submit",function(e){

    e.preventDefault();


    const id =
        document.getElementById("editMenuId").value;


    const item={

        id:
            id ? Number(id) : Date.now(),

        name:
            document.getElementById("foodName").value,

        description:
            document.getElementById("foodDescription").value,

        price:
            Number(document.getElementById("foodPrice").value),

        category:
            document.getElementById("foodCategory").value,

        emoji:
            document.getElementById("foodEmoji").value || "🍽️",

        available:
            document.getElementById("foodAvailable").checked

    };


    if(id){

        const index =
            menuItems.findIndex(
                x=>x.id===Number(id)
            );

        if(index!==-1){
            menuItems[index]=item;
        }

    }else{

        menuItems.push(item);

    }


    saveMenu();

    renderMenu();

    closeMenuModal();

    alert(
        id
        ? "Menu item updated successfully!"
        : "Menu item added successfully!"
    );

});


function deleteMenu(id){

    const item =
        menuItems.find(x=>x.id===id);

    if(!item){
        return;
    }


    if(confirm(
        `Delete "${item.name}" from your menu?`
    )){

        menuItems =
            menuItems.filter(x=>x.id!==id);

        saveMenu();

        renderMenu();

    }

}


function toggleAvailability(id){

    const item =
        menuItems.find(x=>x.id===id);

    if(!item){
        return;
    }

    item.available=!item.available;

    saveMenu();

    renderMenu();

}


function updateMenuCount(){

    const active =
        menuItems.filter(
            item=>item.available
        ).length;


    document.getElementById("activeMenuCount")
        .innerText=active;

    document.getElementById("dashboardMenuItems")
        .innerText=menuItems.length;

}


/* ============================================================
   ORDERS
============================================================ */

function renderOrders(){

    const container =
        document.getElementById("ordersContainer");

    if(orders.length===0){

        container.innerHTML=`
            <p style="color:#777">
                No orders available.
            </p>
        `;

        return;

    }


    container.innerHTML =
        orders.map((order,index)=>`

        <div class="order">

            <div class="order-header">

                <div>

                    <div class="order-id">
                        ${order.id}
                    </div>

                    <small style="color:#777">
                        ${order.table}
                    </small>

                </div>


                <span class="status ${
                    order.status==="Pending"
                    ? "pending"
                    : order.status==="Preparing"
                    ? "preparing"
                    : "completed"
                }">

                    ${order.status}

                </span>

            </div>


            <p>
                ${order.items}
            </p>


            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                margin-top:15px;
            ">

                <strong>
                    ₹${order.amount}
                </strong>


                <div style="display:flex;gap:8px;">

                    ${
                        order.status!=="Completed"
                        ? `
                        <button class="primary-btn"
                                onclick="nextOrderStatus(${index})">

                            ${
                                order.status==="Pending"
                                ? "Accept Order"
                                : "Mark Completed"
                            }

                        </button>
                        `
                        : `
                        <button class="secondary-btn"
                                disabled>
                            Completed ✓
                        </button>
                        `
                    }

                </div>

            </div>

        </div>

    `).join("");

}


function nextOrderStatus(index){

    if(orders[index].status==="Pending"){

        orders[index].status="Preparing";

    }else if(
        orders[index].status==="Preparing"
    ){

        orders[index].status="Completed";

    }

    localStorage.setItem(
        "orders",
        JSON.stringify(orders)
    );

    renderOrders();

    renderDashboardOrders();

}


function addDemoOrder(){

    const orderNumber =
        1000 + orders.length + 1;

    orders.unshift({

        id:"#ORD-"+orderNumber,

        table:"Table "+(
            Math.floor(Math.random()*10)+1
        ),

        items:"1 × Paneer Tikka, 1 × Cold Coffee",

        amount:360,

        status:"Pending"

    });


    localStorage.setItem(
        "orders",
        JSON.stringify(orders)
    );


    renderOrders();

    renderDashboardOrders();

    alert("New order received! 🔔");

}


function renderDashboardOrders(){

    const container =
        document.getElementById("dashboardOrders");

    container.innerHTML =
        orders.slice(0,3).map(order=>`

        <div class="order">

            <div class="order-header">

                <span class="order-id">
                    ${order.id}
                </span>

                <span class="status ${
                    order.status==="Pending"
                    ? "pending"
                    : order.status==="Preparing"
                    ? "preparing"
                    : "completed"
                }">

                    ${order.status}

                </span>

            </div>

            <p>
                ${order.table} —
                ${order.items}
            </p>

            <strong>
                ₹${order.amount}
            </strong>

        </div>

    `).join("");

}


/* ============================================================
   QR CODES
============================================================ */

function renderQR(){

    const container =
        document.getElementById("qrContainer");

    container.innerHTML="";


    const tableCount =
        restaurant
        ? restaurant.tables
        : 10;


    for(let i=1;i<=tableCount;i++){

        const card =
            document.createElement("div");

        card.className="qr-card";


        card.innerHTML=`

            <div class="table-number">
                Table ${i}
            </div>

            <p style="color:#777;margin-top:5px;">
                Scan to order
            </p>

            <div class="qr-code"
                 id="qr-${i}">
            </div>

            <button class="primary-btn"
                    onclick="downloadQR(${i})">
                ⬇ Download QR
            </button>

        `;


        container.appendChild(card);


        new QRCode(
            document.getElementById("qr-"+i),
            {
                text:
                createCustomerURL(i),

                width:170,

                height:170,

                colorDark:"#111",

                colorLight:"#fff",

                correctLevel:
                QRCode.CorrectLevel.H
            }
        );

    }

}


function createCustomerURL(table){

    /*
       In a real deployed website this URL should point
       to your customer ordering page.

       Example:
       https://yourrestaurant.com/menu?table=1
    */

    return window.location.href.split("#")[0]
        +"?customer=true&table="+table;

}


function downloadQR(table){

    const qr =
        document.querySelector(
            "#qr-"+table+" img"
        );

    if(!qr){

        alert("QR is still generating. Try again.");

        return;

    }


    const link =
        document.createElement("a");

    link.href=qr.src;

    link.download=
        "Restaurant-Table-"+table+"-QR.png";

    link.click();

}


function downloadAllQR(){

    const tableCount =
        restaurant
        ? restaurant.tables
        : 10;

    alert(
        `Your ${tableCount} table QR codes are ready. `+
        `Use the Download QR button under each table.`
    );

}


/* ============================================================
   CUSTOMER MENU
============================================================ */

function showCustomerPreview(){

    document.getElementById("customerPreview")
        .classList.remove("hidden");

    renderCustomerMenu(1);

}


function closeCustomerPreview(){

    document.getElementById("customerPreview")
        .classList.add("hidden");

}


function renderCustomerMenu(table){

    document.getElementById("customerRestaurantName")
        .innerText=
        restaurant
        ? restaurant.name
        : "My Restaurant";

    document.getElementById("customerTableNumber")
        .innerText=table;


    const container =
        document.getElementById("customerMenu");


    const available =
        menuItems.filter(
            item=>item.available
        );


    const categories=[
        "Starters",
        "Main Course",
        "Pizza",
        "Beverages",
        "Desserts"
    ];


    let html="";


    categories.forEach(category=>{

        const items =
            available.filter(
                item=>item.category===category
            );


        if(items.length===0){
            return;
        }


        html+=`

            <div class="customer-category">
                ${category}
            </div>

        `;


        items.forEach(item=>{

            html+=`

                <div class="customer-item">

                    <div class="customer-item-info">

                        <h4>
                            ${item.emoji}
                            ${escapeHTML(item.name)}
                        </h4>

                        <p>
                            ${escapeHTML(
                                item.description || ""
                            )}
                        </p>

                    </div>


                    <div class="customer-item-right">

                        <div class="customer-price">
                            ₹${item.price}
                        </div>

                        <button class="add-btn"
                                onclick="addToCart('${escapeJS(item.name)}')">

                            + Add

                        </button>

                    </div>

                </div>

            `;

        });

    });


    if(!html){

        html=`

            <div style="
                text-align:center;
                padding:50px 20px;
            ">

                <h3>
                    Menu currently unavailable
                </h3>

                <p style="
                    color:#777;
                    margin-top:8px;
                ">
                    Please contact restaurant staff.
                </p>

            </div>

        `;

    }


    container.innerHTML=html;

}


function addToCart(name){

    alert(
        `${name} added to your cart! 🛒`
    );

}


