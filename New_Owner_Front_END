<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>RestoHub — Restaurant Management</title>

<!-- QR Generator -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#f5f6fa;
    color:#202124;
}

/* =========================
   COMMON
========================= */

button{
    border:none;
    cursor:pointer;
}

.hidden{
    display:none !important;
}

.primary-btn{
    background:#ff5a36;
    color:white;
    padding:13px 22px;
    border-radius:10px;
    font-size:15px;
    font-weight:bold;
    transition:.2s;
}

.primary-btn:hover{
    background:#e94725;
    transform:translateY(-1px);
}

.secondary-btn{
    background:#f1f3f5;
    color:#333;
    padding:12px 18px;
    border-radius:9px;
    font-weight:bold;
}

.danger-btn{
    background:#ffe8e4;
    color:#e53920;
    padding:9px 14px;
    border-radius:8px;
    font-weight:bold;
}

.edit-btn{
    background:#eaf2ff;
    color:#246bce;
    padding:9px 14px;
    border-radius:8px;
    font-weight:bold;
}

/* =========================
   PAGE 1
========================= */

#authPage{
    min-height:100vh;
    display:flex;
    background:#fff;
}

.auth-left{
    width:52%;
    background:linear-gradient(135deg,#ff5a36,#ff8b39);
    color:white;
    padding:80px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

.auth-logo{
    font-size:32px;
    font-weight:900;
    margin-bottom:55px;
}

.auth-left h1{
    font-size:60px;
    line-height:1.05;
    margin-bottom:25px;
}

.auth-left p{
    font-size:19px;
    line-height:1.7;
    max-width:580px;
    opacity:.95;
}

.auth-features{
    margin-top:45px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:18px;
}

.auth-feature{
    background:rgba(255,255,255,.15);
    padding:18px;
    border-radius:14px;
    backdrop-filter:blur(10px);
}

.auth-right{
    width:48%;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:40px;
}

.auth-box{
    width:100%;
    max-width:500px;
}

.auth-box h2{
    font-size:38px;
    margin-bottom:10px;
}

.auth-box .subtitle{
    color:#777;
    margin-bottom:30px;
}

.auth-tabs{
    display:flex;
    background:#f2f3f5;
    border-radius:12px;
    padding:5px;
    margin-bottom:25px;
}

.auth-tabs button{
    flex:1;
    padding:13px;
    border-radius:9px;
    background:transparent;
    font-weight:bold;
    font-size:15px;
}

.auth-tabs button.active{
    background:white;
    color:#ff5a36;
    box-shadow:0 2px 8px rgba(0,0,0,.08);
}

.input-group{
    margin-bottom:18px;
}

.input-group label{
    display:block;
    font-weight:bold;
    margin-bottom:8px;
    font-size:14px;
}

.input-group input,
.input-group select,
.input-group textarea{
    width:100%;
    padding:15px;
    border:1px solid #ddd;
    border-radius:10px;
    outline:none;
    font-size:15px;
    background:white;
}

.input-group input:focus,
.input-group select:focus,
.input-group textarea:focus{
    border-color:#ff5a36;
    box-shadow:0 0 0 3px rgba(255,90,54,.1);
}

.full-btn{
    width:100%;
    margin-top:5px;
}

/* =========================
   PAGE 2
========================= */

#detailsPage{
    min-height:100vh;
    background:#f7f8fa;
    padding:45px;
}

.details-wrapper{
    max-width:1100px;
    margin:auto;
}

.details-header{
    margin-bottom:30px;
}

.details-header h1{
    font-size:38px;
    margin-bottom:8px;
}

.details-header p{
    color:#777;
}

.details-card{
    background:white;
    border-radius:18px;
    padding:35px;
    box-shadow:0 10px 35px rgba(0,0,0,.07);
}

.form-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.full{
    grid-column:1/-1;
}

.form-actions{
    margin-top:25px;
    display:flex;
    justify-content:flex-end;
    gap:12px;
}

/* =========================
   DASHBOARD
========================= */

#dashboardPage{
    min-height:100vh;
    display:flex;
}

.sidebar{
    width:260px;
    background:#151719;
    color:white;
    padding:25px 16px;
    position:fixed;
    top:0;
    bottom:0;
    left:0;
    overflow-y:auto;
}

.brand{
    padding:10px 15px 30px;
    font-size:25px;
    font-weight:900;
}

.brand span{
    color:#ff5a36;
}

.sidebar-section{
    color:#777;
    font-size:11px;
    font-weight:bold;
    padding:15px;
    text-transform:uppercase;
}

.side-btn{
    width:100%;
    padding:14px 15px;
    margin:3px 0;
    background:transparent;
    color:#bbb;
    border-radius:9px;
    text-align:left;
    font-size:14px;
    font-weight:bold;
}

.side-btn:hover,
.side-btn.active{
    background:#ff5a36;
    color:white;
}

.logout{
    margin-top:25px;
}

.dashboard-main{
    margin-left:260px;
    width:calc(100% - 260px);
}

.topbar{
    height:75px;
    background:white;
    border-bottom:1px solid #eee;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 30px;
}

.topbar h2{
    font-size:22px;
}

.admin-profile{
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:40px;
    height:40px;
    background:#ff5a36;
    color:white;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:bold;
}

.content{
    padding:30px;
}

.page-section{
    display:none;
}

.page-section.active{
    display:block;
}

/* =========================
   DASHBOARD CARDS
========================= */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:18px;
    margin-bottom:25px;
}

.stat-card{
    background:white;
    padding:22px;
    border-radius:15px;
    box-shadow:0 4px 20px rgba(0,0,0,.04);
}

.stat-top{
    display:flex;
    justify-content:space-between;
    color:#777;
    font-size:14px;
}

.stat-value{
    font-size:30px;
    font-weight:900;
    margin-top:12px;
}

.green{
    color:#16a34a;
}

.orange{
    color:#ff5a36;
}

.blue{
    color:#2878d8;
}

.purple{
    color:#8556d9;
}

.dashboard-grid{
    display:grid;
    grid-template-columns:2fr 1fr;
    gap:20px;
}

.panel{
    background:white;
    padding:25px;
    border-radius:15px;
    box-shadow:0 4px 20px rgba(0,0,0,.04);
}

.panel-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.panel-header h3{
    font-size:19px;
}

/* =========================
   ORDERS
========================= */

.order{
    border:1px solid #eee;
    border-radius:12px;
    padding:16px;
    margin-bottom:12px;
}

.order-header{
    display:flex;
    justify-content:space-between;
    margin-bottom:10px;
}

.order-id{
    font-weight:bold;
}

.status{
    padding:5px 10px;
    border-radius:20px;
    font-size:11px;
    font-weight:bold;
}

.pending{
    background:#fff3cd;
    color:#a16207;
}

.preparing{
    background:#e0edff;
    color:#2563eb;
}

.completed{
    background:#dcfce7;
    color:#15803d;
}

/* =========================
   MENU
========================= */

.menu-toolbar{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.menu-toolbar-left{
    display:flex;
    gap:10px;
}

.search{
    padding:12px 15px;
    border:1px solid #ddd;
    border-radius:9px;
    width:250px;
}

.menu-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
}

.menu-card{
    background:white;
    border-radius:15px;
    overflow:hidden;
    box-shadow:0 4px 20px rgba(0,0,0,.05);
}

.menu-image{
    height:150px;
    background:#eee;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:50px;
}

.menu-body{
    padding:17px;
}

.menu-body h3{
    margin-bottom:7px;
}

.menu-description{
    color:#777;
    font-size:13px;
    min-height:35px;
}

.price{
    font-size:20px;
    font-weight:bold;
    color:#ff5a36;
    margin:12px 0;
}

.menu-footer{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.availability{
    display:flex;
    align-items:center;
    gap:7px;
    font-size:12px;
    font-weight:bold;
}

.dot{
    width:9px;
    height:9px;
    border-radius:50%;
    background:#22c55e;
}

.dot.off{
    background:#ef4444;
}

.menu-actions{
    display:flex;
    gap:6px;
}

/* =========================
   MODAL
========================= */

.modal{
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    display:flex;
    align-items:center;
    justify-content:center;
    z-index:100;
}

.modal-box{
    background:white;
    width:500px;
    max-width:94%;
    border-radius:18px;
    padding:28px;
}

.modal-header{
    display:flex;
    justify-content:space-between;
    margin-bottom:20px;
}

.close{
    background:#eee;
    width:32px;
    height:32px;
    border-radius:50%;
}

.modal-actions{
    display:flex;
    justify-content:flex-end;
    gap:10px;
}

/* =========================
   QR
========================= */

.qr-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:20px;
}

.qr-card{
    background:white;
    border-radius:15px;
    padding:25px;
    text-align:center;
    box-shadow:0 4px 20px rgba(0,0,0,.05);
}

.qr-code{
    margin:20px auto;
    width:170px;
    height:170px;
    display:flex;
    justify-content:center;
}

.table-number{
    font-size:22px;
    font-weight:bold;
}

/* =========================
   EARNINGS
========================= */

.earning-summary{
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    gap:20px;
    margin-bottom:25px;
}

.earning-card{
    background:white;
    padding:25px;
    border-radius:15px;
}

.earning-card h4{
    color:#777;
    margin-bottom:10px;
}

.earning-card strong{
    font-size:32px;
}

.chart{
    height:320px;
    background:white;
    border-radius:15px;
    padding:25px;
}

.bars{
    height:240px;
    display:flex;
    align-items:end;
    justify-content:space-around;
    gap:15px;
    border-bottom:1px solid #ddd;
}

.bar-wrap{
    height:100%;
    display:flex;
    align-items:end;
    flex-direction:column;
    justify-content:end;
}

.bar{
    width:35px;
    background:#ff5a36;
    border-radius:6px 6px 0 0;
}

.bar-label{
    font-size:11px;
    margin-top:7px;
}

/* =========================
   SETTINGS
========================= */

.settings-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:20px;
}

.setting-card{
    background:white;
    padding:25px;
    border-radius:15px;
}

.setting-card h3{
    margin-bottom:20px;
}

.info-row{
    display:flex;
    justify-content:space-between;
    padding:14px 0;
    border-bottom:1px solid #eee;
}

.info-row:last-child{
    border-bottom:none;
}

.info-label{
    color:#777;
}

/* =========================
   CUSTOMER PREVIEW
========================= */

.customer-page{
    max-width:500px;
    margin:auto;
    background:white;
    min-height:100vh;
    padding-bottom:30px;
}

.customer-header{
    background:#ff5a36;
    color:white;
    padding:30px 20px;
    text-align:center;
}

.customer-header h1{
    font-size:28px;
}

.customer-table{
    font-size:13px;
    opacity:.9;
    margin-top:6px;
}

.customer-category{
    padding:20px 20px 8px;
    font-weight:900;
    font-size:18px;
}

.customer-item{
    display:flex;
    justify-content:space-between;
    padding:16px 20px;
    border-bottom:1px solid #eee;
}

.customer-item-info{
    max-width:70%;
}

.customer-item h4{
    margin-bottom:5px;
}

.customer-item p{
    color:#888;
    font-size:12px;
}

.customer-item-right{
    text-align:right;
}

.customer-price{
    font-weight:bold;
    color:#ff5a36;
}

.add-btn{
    margin-top:7px;
    background:#ff5a36;
    color:white;
    padding:6px 12px;
    border-radius:7px;
    font-size:12px;
}

/* =========================
   RESPONSIVE
========================= */

@media(max-width:1000px){

    .auth-left{
        display:none;
    }

    .auth-right{
        width:100%;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .menu-grid{
        grid-template-columns:1fr 1fr;
    }

    .qr-grid{
        grid-template-columns:1fr 1fr;
    }

}

@media(max-width:700px){

    .sidebar{
        width:70px;
    }

    .brand{
        font-size:0;
    }

    .brand span{
        font-size:22px;
    }

    .side-btn{
        font-size:0;
        text-align:center;
    }

    .side-btn::first-letter{
        font-size:20px;
    }

    .dashboard-main{
        margin-left:70px;
        width:calc(100% - 70px);
    }

    .content{
        padding:15px;
    }

    .stats,
    .menu-grid,
    .qr-grid,
    .earning-summary,
    .settings-grid{
        grid-template-columns:1fr;
    }

    .dashboard-grid{
        grid-template-columns:1fr;
    }

    .form-grid{
        grid-template-columns:1fr;
    }

    .full{
        grid-column:auto;
    }
}
</style>
</head>

<body>

<!-- ============================================================
     PAGE 1 — LOGIN / SIGNUP
============================================================ -->

<section id="authPage">

    <div class="auth-left">

        <div class="auth-logo">🍽️ RestoHub</div>

        <h1>Run your restaurant smarter.</h1>

        <p>
            Manage your menu, receive orders, generate table QR codes,
            track earnings and control your complete restaurant from one
            simple dashboard.
        </p>

        <div class="auth-features">

            <div class="auth-feature">
                <b>🍔 Smart Menu</b>
                <p>Add, edit and manage food items.</p>
            </div>

            <div class="auth-feature">
                <b>📱 QR Ordering</b>
                <p>Let customers order directly from their table.</p>
            </div>

            <div class="auth-feature">
                <b>🔔 Live Orders</b>
                <p>Get instant order notifications.</p>
            </div>

            <div class="auth-feature">
                <b>📊 Earnings</b>
                <p>Track your daily and weekly sales.</p>
            </div>

        </div>

    </div>


    <div class="auth-right">

        <div class="auth-box">

            <h2 id="authTitle">Welcome Back 👋</h2>

            <p class="subtitle" id="authSubtitle">
                Login to manage your restaurant.
            </p>

            <div class="auth-tabs">

                <button id="loginTab"
                        class="active"
                        onclick="showLogin()">
                    Login
                </button>

                <button id="signupTab"
                        onclick="showSignup()">
                    Sign Up
                </button>

            </div>


            <!-- LOGIN -->

            <form id="loginForm">

                <div class="input-group">
                    <label>Email Address</label>
                    <input id="loginEmail"
                           type="email"
                           placeholder="admin@example.com"
                           required>
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <input id="loginPassword"
                           type="password"
                           placeholder="Enter password"
                           required>
                </div>

                <button class="primary-btn full-btn">
                    Login to Dashboard
                </button>

            </form>


            <!-- SIGNUP -->

            <form id="signupForm" class="hidden">

                <div class="input-group">
                    <label>Admin Name</label>
                    <input id="signupName"
                           placeholder="Enter your name"
                           required>
                </div>

                <div class="input-group">
                    <label>Email Address</label>
                    <input id="signupEmail"
                           type="email"
                           placeholder="admin@example.com"
                           required>
                </div>

                <div class="input-group">
                    <label>Password</label>
                    <input id="signupPassword"
                           type="password"
                           placeholder="Create password"
                           required>
                </div>

                <button class="primary-btn full-btn">
                    Create Admin Account
                </button>

            </form>

        </div>

    </div>

</section>


<!-- ============================================================
     PAGE 2 — RESTAURANT DETAILS
============================================================ -->

<section id="detailsPage" class="hidden">

    <div class="details-wrapper">

        <div class="details-header">

            <h1>Set Up Your Restaurant 🍽️</h1>

            <p>
                Enter your restaurant information before entering
                the admin dashboard.
            </p>

        </div>


        <div class="details-card">

            <form id="restaurantForm">

                <div class="form-grid">

                    <div class="input-group">
                        <label>Restaurant Name *</label>
                        <input id="restaurantName"
                               placeholder="e.g. Spice Garden"
                               required>
                    </div>

                    <div class="input-group">
                        <label>Owner Name *</label>
                        <input id="ownerName"
                               placeholder="Restaurant owner"
                               required>
                    </div>

                    <div class="input-group">
                        <label>GST Number</label>
                        <input id="gst"
                               placeholder="22AAAAA0000A1Z5">
                    </div>

                    <div class="input-group">
                        <label>Restaurant Phone *</label>
                        <input id="restaurantPhone"
                               placeholder="+91 98765 43210"
                               required>
                    </div>

                    <div class="input-group">
                        <label>Email Address</label>
                        <input id="restaurantEmail"
                               type="email"
                               placeholder="restaurant@example.com">
                    </div>

                    <div class="input-group">
                        <label>Number of Tables</label>
                        <input id="tableCount"
                               type="number"
                               min="1"
                               max="100"
                               value="10"
                               required>
                    </div>

                    <div class="input-group">
                        <label>Opening Time</label>
                        <input id="openingTime"
                               type="time"
                               value="10:00">
                    </div>

                    <div class="input-group">
                        <label>Closing Time</label>
                        <input id="closingTime"
                               type="time"
                               value="23:00">
                    </div>

                    <div class="input-group full">
                        <label>Restaurant Address *</label>

                        <textarea id="restaurantAddress"
                                  rows="3"
                                  placeholder="Enter complete restaurant address"
                                  required></textarea>

                    </div>

                </div>


                <div class="form-actions">

                    <button type="button"
                            class="secondary-btn"
                            onclick="backToAuth()">
                        Back
                    </button>

                    <button class="primary-btn">
                        Save & Continue →
                    </button>

                </div>

            </form>

        </div>

    </div>

</section>


<!-- ============================================================
     PAGE 3 — ADMIN DASHBOARD
============================================================ -->

<section id="dashboardPage" class="hidden">

    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="brand">
            🍽️ <span>RestoHub</span>
        </div>


        <div class="sidebar-section">
            Main
        </div>

        <button class="side-btn active"
                onclick="openSection('dashboard',this)">
            📊 Dashboard
        </button>

        <button class="side-btn"
                onclick="openSection('orders',this)">
            🔔 Orders
        </button>

        <button class="side-btn"
                onclick="openSection('menu',this)">
            🍔 Customize Menu
        </button>

        <button class="side-btn"
                onclick="openSection('qr',this)">
            📱 QR Tables
        </button>

        <button class="side-btn"
                onclick="openSection('earnings',this)">
            💰 Earnings
        </button>


        <div class="sidebar-section">
            Restaurant
        </div>

        <button class="side-btn"
                onclick="openSection('settings',this)">
            ⚙️ Settings
        </button>

        <button class="side-btn"
                onclick="showCustomerPreview()">
            👀 Customer Menu
        </button>

        <button class="side-btn logout"
                onclick="logout()">
            🚪 Logout
        </button>

    </aside>


    <!-- MAIN -->

    <main class="dashboard-main">

        <header class="topbar">

            <h2 id="sectionTitle">
                Dashboard
            </h2>

            <div class="admin-profile">

                <span id="topRestaurantName">
                    My Restaurant
                </span>

                <div class="avatar">
                    A
                </div>

            </div>

        </header>


        <div class="content">


            <!-- ================= DASHBOARD ================= -->

            <section id="dashboardSection"
                     class="page-section active">

                <div class="stats">

                    <div class="stat-card">
                        <div class="stat-top">
                            Today's Sales
                            <span>💰</span>
                        </div>

                        <div class="stat-value orange">
                            ₹12,850
                        </div>

                        <small class="green">
                            ↑ 12.5% from yesterday
                        </small>
                    </div>


                    <div class="stat-card">
