/* ============================================================
   INITIALIZATION
============================================================ */

function initializeDashboard(){

    loadRestaurant();

    updateMenuCount();

    renderMenu();

    renderOrders();

    renderDashboardOrders();

    renderQR();

}


function escapeHTML(text){

    return String(text)
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function escapeJS(text){

    return String(text)
        .replace(/\\/g,"\\\\")
        .replace(/'/g,"\\'")
        .replace(/"/g,'\\"');

}


