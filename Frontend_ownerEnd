<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>QROrder | Owner Dashboard</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,Helvetica,sans-serif;background:#f5f6f8;color:#151515}
button,input,select{font:inherit}button{cursor:pointer}
header{height:78px;background:#101725;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 4%;position:sticky;top:0;z-index:100}
.logo-area{display:flex;align-items:center;gap:12px}.logo{width:44px;height:44px;background:#ffa500;color:#111;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:bold}.logo-text h2{font-size:20px}.logo-text p{font-size:10px;color:#aeb5c2;margin-top:3px}
.live{color:#40df7a;font-size:13px;font-weight:bold}
.layout{display:grid;grid-template-columns:230px 1fr;min-height:calc(100vh - 78px)}
.sidebar{background:#151d2b;color:#fff;padding:20px 14px;position:sticky;top:78px;height:calc(100vh - 78px)}
.sidebar button{display:block;width:100%;text-align:left;border:0;background:transparent;color:#cbd2dd;padding:13px;border-radius:9px;margin-bottom:6px}.sidebar button:hover,.sidebar button.active{background:#303c50;color:#fff}
.main{padding:28px;overflow:hidden}.page{display:none}.page.active{display:block}
.heading{display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}.heading h1{font-size:34px}.heading p{color:#777;margin-top:5px}
.refresh{border:0;background:#151515;color:#fff;padding:11px 15px;border-radius:9px}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px;margin-top:22px}
.stat{background:#fff;border:1px solid #e1e4e8;border-radius:14px;padding:18px}.stat small{color:#777}.stat strong{display:block;font-size:28px;margin-top:7px;color:#df8100}
.panel{background:#fff;border:1px solid #e1e4e8;border-radius:14px;padding:18px;margin-top:18px}
.filters{display:flex;gap:10px;flex-wrap:wrap;margin-top:15px}.filters button{border:1px solid #ddd;background:#fff;padding:9px 13px;border-radius:8px}.filters button.active{background:#151515;color:#fff}
.order-card{border:1px solid #e2e2e2;border-radius:12px;padding:15px;margin-top:12px}.order-top{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}.token{font-size:20px;font-weight:bold}.order-meta{color:#777;font-size:13px;margin-top:5px}.items{margin-top:10px;padding:10px;background:#f8f8f8;border-radius:9px}
.actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.actions button{border:0;padding:9px 11px;border-radius:8px;background:#eee}.actions button:hover{background:#ddd}.actions .prepare{background:#ffe3a8}.actions .ready{background:#dff8e8}.actions .done{background:#dbeafe}
.badge{padding:6px 9px;border-radius:15px;background:#e9f8ef;color:#14994b;font-size:12px;font-weight:bold}
table{width:100%;border-collapse:collapse;margin-top:12px}th,td{padding:11px;border-bottom:1px solid #eee;text-align:left}th{background:#f7f7f7}
.search{width:100%;padding:11px;border:1px solid #ddd;border-radius:8px}
.danger{background:#e74c3c!important;color:#fff!important}.empty{text-align:center;padding:45px;color:#777}
.toast{position:fixed;top:95px;right:20px;z-index:1000;background:#151515;color:#fff;padding:15px 18px;border-radius:12px;transform:translateX(130%);opacity:0;transition:.3s}.toast.show{transform:translateX(0);opacity:1}
@media(max-width:900px){.layout{grid-template-columns:1fr}.sidebar{position:static;height:auto;display:flex;overflow:auto;gap:6px}.sidebar button{min-width:125px;margin:0}.stats{grid-template-columns:repeat(2,1fr)}.main{padding:18px}}
@media(max-width:550px){.stats{grid-template-columns:1fr}.heading h1{font-size:27px}}
</style>
</head>
<body>
<header>
  <div class="logo-area"><div class="logo">QR</div><div class="logo-text"><h2>QROrder Owner</h2><p>Kitchen + Admin Dashboard</p></div></div>
  <div class="live">● Live Dashboard</div>
</header>

<div class="layout">
<aside class="sidebar">
  <button class="active" onclick="showPage('overview',this)">📊 Overview</button>
  <button onclick="showPage('kitchen',this)">👨‍🍳 Kitchen</button>
  <button onclick="showPage('orders',this)">🧾 All Orders</button>
  <button onclick="showPage('menu',this)">🍽️ Menu</button>
  <button onclick="showPage('feedback',this)">⭐ Feedback</button>
  <button onclick="showPage('tables',this)">🪑 Tables</button>
  <button onclick="showPage('settings',this)">⚙️ Settings</button>
</aside>

<main class="main">
<section class="page active" id="overview">
  <div class="heading"><div><h1>Restaurant Overview</h1><p>Full owner-side data. This page is separate from the customer page.</p></div><button class="refresh" onclick="renderAll()">↻ Refresh</button></div>
  <div class="stats">
    <div class="stat"><small>Total Orders</small><strong id="sOrders">0</strong></div>
    <div class="stat"><small>Pending</small><strong id="sPending">0</strong></div>
    <div class="stat"><small>Completed</small><strong id="sCompleted">0</strong></div>
    <div class="stat"><small>Revenue</small><strong id="sRevenue">₹0</strong></div>
  </div>
  <div class="panel"><h2>Recent Orders</h2><div id="recentOrders"></div></div>
</section>

<section class="page" id="kitchen">
  <div class="heading"><div><h1>Kitchen Dashboard</h1><p>Live order queue for kitchen staff.</p></div><button class="refresh" onclick="renderKitchen()">↻ Refresh</button></div>
  <div class="filters"><button class="active" onclick="setKitchenFilter('All',this)">All</button><button onclick="setKitchenFilter('Order Received',this)">New</button><button onclick="setKitchenFilter('Preparing',this)">Preparing</button><button onclick="setKitchenFilter('Ready',this)">Ready</button><button onclick="setKitchenFilter('Completed',this)">Completed</button></div>
  <div id="kitchenOrders"></div>
</section>

<section class="page" id="orders">
  <div class="heading"><div><h1>All Orders</h1><p>Complete order history stored in this browser.</p></div></div>
  <div class="panel"><input class="search" id="orderSearch" placeholder="Search token, table, item..." oninput="renderOrders()"><div id="allOrders"></div></div>
</section>

<section class="page" id="menu">
  <div class="heading"><div><h1>Menu</h1><p>Current customer-facing menu.</p></div></div>
  <div class="panel"><table><thead><tr><th>Item</th><th>Category</th><th>Price</th><th>Status</th></tr></thead><tbody id="menuRows"></tbody></table></div>
</section>

<section class="page" id="feedback">
  <div class="heading"><div><h1>Customer Feedback</h1><p>Feedback submitted by customers.</p></div></div>
  <div class="panel" id="feedbackPanel"></div>
</section>

<section class="page" id="tables">
  <div class="heading"><div><h1>Tables</h1><p>50 restaurant tables in the current demo.</p></div></div>
  <div class="panel"><table><thead><tr><th>Table</th><th>Current Orders</th><th>State</th></tr></thead><tbody id="tableRows"></tbody></table></div>
</section>

<section class="page" id="settings">
  <div class="heading"><div><h1>Settings</h1><p>Demo controls.</p></div></div>
  <div class="panel">
    <h3>Owner Controls</h3>
    <div class="actions">
      <button onclick="exportData()">⬇ Export Full Data</button>
      <button class="danger" onclick="clearAllData()">♻ Clear All Demo Data</button>
      <button onclick="window.open('customer.html','_blank')">📱 Open Customer Page</button>
    </div>
    <p style="margin-top:15px;color:#777">For real deployment, replace localStorage with your Spring Boot API/database. That will allow customer devices and owner devices to communicate over the internet.</p>
  </div>
</section>
</main>
</div>

<div class="toast" id="toast"><b id="toastTitle"></b><br><span id="toastMsg"></span></div>

<script>
const foods=[
["Paneer Tikka","Starters",180],["Veg Manchurian","Starters",150],["Masala Dosa","South Indian",120],["Idli Sambar","South Indian",90],["Veg Biryani","Main Course",190],["Paneer Butter Masala","Main Course",220],["Dal Tadka","Main Course",140],["Butter Naan","Breads",50],["Tandoori Roti","Breads",35],["Cold Coffee","Drinks",110],["Fresh Lime Soda","Drinks",70],["Mango Shake","Drinks",130],["Gulab Jamun","Desserts",90],["Ice Cream","Desserts",80],["Chocolate Brownie","Desserts",120],["Veg Spring Roll","Starters",130],["Hara Bhara Kabab","Starters",160],["Chole Bhature","Main Course",150]];
let kitchenFilter="All";

function getOrders(){return JSON.parse(localStorage.getItem("qroderOrders")||"[]")}
function saveOrders(x){localStorage.setItem("qroderOrders",JSON.stringify(x))}
function showPage(id,btn){document.querySelectorAll(".page").forEach(x=>x.classList.remove("active"));document.getElementById(id).classList.add("active");document.querySelectorAll(".sidebar button").forEach(x=>x.classList.remove("active"));if(btn)btn.classList.add("active");renderAll()}
function statusClass(s){return s==="Completed"?"done":s==="Ready"?"ready":"prepare"}

function orderCard(o){
return `<div class="order-card"><div class="order-top"><div><div class="token">${o.token}</div><div class="order-meta">${o.createdAt} · ${o.table} · ${o.orderType}</div></div><span class="badge">${o.status}</span></div><div class="items">${o.items.map(i=>`${i.icon||"🍽️"} ${i.name} × ${i.quantity} — ₹${i.price*i.quantity}`).join("<br>")}${o.instructions?`<br><br><b>Note:</b> ${o.instructions}`:""}</div><div class="actions"><button class="prepare" onclick="setStatus('${o.token}','Preparing')">👨‍🍳 Preparing</button><button class="ready" onclick="setStatus('${o.token}','Ready')">✅ Ready</button><button class="done" onclick="setStatus('${o.token}','Completed')">🏁 Completed</button></div></div>`
}

function renderOverview(){
let os=getOrders(),pending=os.filter(o=>o.status!=="Completed").length,done=os.filter(o=>o.status==="Completed").length,revenue=os.reduce((s,o)=>s+Number(o.total||0),0);
sOrders.textContent=os.length;sPending.textContent=pending;sCompleted.textContent=done;sRevenue.textContent="₹"+revenue;
recentOrders.innerHTML=os.length?os.slice(-5).reverse().map(orderCard).join(""):'<div class="empty">No orders yet.</div>'
}
function setKitchenFilter(f,b){kitchenFilter=f;document.querySelectorAll("#kitchen .filters button").forEach(x=>x.classList.remove("active"));b.classList.add("active");renderKitchen()}
function renderKitchen(){let os=getOrders().filter(o=>kitchenFilter==="All"||o.status===kitchenFilter);document.getElementById("kitchenOrders").innerHTML=os.length?os.slice().reverse().map(orderCard).join(""):'<div class="empty">No matching orders.</div>'}
function renderOrders(){let q=(document.getElementById("orderSearch")?.value||"").toLowerCase();let os=getOrders().filter(o=>JSON.stringify(o).toLowerCase().includes(q));document.getElementById("allOrders").innerHTML=os.length?os.slice().reverse().map(orderCard).join(""):'<div class="empty">No orders found.</div>'}
function setStatus(token,status){
let os=getOrders();let o=os.find(x=>x.token===token);if(!o)return;o.status=status;saveOrders(os);localStorage.setItem("lastOrder",JSON.stringify(o));localStorage.setItem("qroderStatus",JSON.stringify({token,status,at:Date.now()}));
if(window.BroadcastChannel){try{new BroadcastChannel("qroder_live").postMessage({type:"status",token,status})}catch(e){}}
showToast("Order Updated",token+" → "+status);renderAll()
}
function renderMenu(){document.getElementById("menuRows").innerHTML=foods.map(f=>`<tr><td>${f[0]}</td><td>${f[1]}</td><td>₹${f[2]}</td><td><span class="badge">Available</span></td></tr>`).join("")}
function renderFeedback(){let f=JSON.parse(localStorage.getItem("customerFeedback")||"null");document.getElementById("feedbackPanel").innerHTML=f?`<h3>Latest Feedback</h3><p style="margin-top:10px">Token: <b>${f.token||"—"}</b></p><p>Rating: <b>${"★".repeat(f.rating)}${"☆".repeat(5-f.rating)}</b></p><p style="margin-top:8px">${f.feedback||"No written comment."}</p><p style="margin-top:8px;color:#777">${f.createdAt}</p>`:'<div class="empty">No feedback submitted yet.</div>'}
function renderTables(){let os=getOrders();let html="";for(let i=1;i<=50;i++){let t="T"+String(i).padStart(2,"0"),n=os.filter(o=>o.table===t&&o.status!=="Completed").length;html+=`<tr><td>${t}</td><td>${n}</td><td><span class="badge">${n?"Occupied":"Available"}</span></td></tr>`}document.getElementById("tableRows").innerHTML=html}
function renderAll(){renderOverview();renderKitchen();renderOrders();renderMenu();renderFeedback();renderTables()}
function showToast(t,m){let x=document.getElementById("toast");toastTitle.textContent=t;toastMsg.textContent=m;x.classList.add("show");setTimeout(()=>x.classList.remove("show"),2200)}
function exportData(){let data={orders:getOrders(),feedback:JSON.parse(localStorage.getItem("customerFeedback")||"null"),lastOrder:JSON.parse(localStorage.getItem("lastOrder")||"null"),exportedAt:new Date().toLocaleString()};let blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),url=URL.createObjectURL(blob),a=document.createElement("a");a.href=url;a.download="qroder-full-data.json";a.click();URL.revokeObjectURL(url)}
function clearAllData(){if(!confirm("Delete all QROrder demo orders and feedback?"))return;localStorage.removeItem("qroderOrders");localStorage.removeItem("lastOrder");localStorage.removeItem("customerFeedback");renderAll();showToast("Data Cleared","All demo data was removed")}
if(window.BroadcastChannel){try{let ch=new BroadcastChannel("qroder_live");ch.onmessage=e=>{renderAll();if(e.data.type==="newOrder")showToast("New Order",e.data.order.token+" received")}}catch(e){}}
window.addEventListener("storage",()=>renderAll());
renderAll();
setInterval(renderAll,2000);
</script>
</body>
</html>
